# Copy this file to .env and fill in the values. Never commit .env.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Local Postgres (docker compose up -d starts one with these settings)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce
DB_NAME=ecommerce

# Optional in development, required in production
REDIS_URL=redis://localhost:6379

# Production: long random values (for example: openssl rand -hex 32)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Do not send usage data to Medusa
MEDUSA_DISABLE_TELEMETRY=true

# Phone login codes. Production: OTP_SECRET = long random value,
# SMS_PROVIDER=messagecentral or msg91 (see docs/SETUP-SMS.md)
OTP_SECRET=
SMS_PROVIDER=console
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_PASSWORD=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VAR=otp
# Development/tests only: every code is this value (only with SMS_PROVIDER=console, never in production)
OTP_TEST_CODE=

# Online payments (Razorpay). Test keys start with rzp_test_. See docs/SETUP-PAYMENTS.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Tests only: a fake Razorpay (node integration-tests/fake-razorpay.js). Refused in production.
RAZORPAY_API_BASE=

# Delivery (Shiprocket API user) and tracking webhook token. See docs/SETUP-SHIPPING.md
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
# Tests only: a fake Shiprocket (node integration-tests/fake-shiprocket.js). Refused in production.
SHIPROCKET_API_BASE=

# Order emails (Resend) and links in messages
RESEND_API_KEY=
EMAIL_FROM=
ORDER_ALERT_EMAIL=
STOREFRONT_URL=http://localhost:8000
# Tests only. Refused in production.
RESEND_API_BASE=

# Order-update SMS through Message Central (needs approved DLT templates)
SMS_ORDER_UPDATES=false
MESSAGECENTRAL_SENDER_ID=
MESSAGECENTRAL_ENTITY_ID=
SMS_TEMPLATE_IDS=
